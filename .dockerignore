# Version control & development tools
.git
.gitignore
.gitattributes
.vscode
.claude
.codex
.impeccable
.playwright-mcp
.agents

# Environment variables & secrets (NEVER include in images)
.env
.env.*
backend/.env
backend/.env.*
*.env

# Python build artifacts & virtual environments
__pycache__
*.py[cod]
*$py.class
*.so
.pytest_cache
.venv
venv
ENV/
env/

# Test suites & test artifacts (not needed in production runtime)
tests/
test/
backend/_fill_pipeline_test.py
backend/_pos_test.py

# Documentation
docs/
*.md
!backend/README.md

# Frontend (deployed independently to Vercel)
frontend/
node_modules/

# Local databases and runtime state
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/uploads/*
backend/data/vectors/*
backend/data/huggingface/*
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/*
data/vectors/*
data/tessdata/*
data/*.traineddata
data/*.txt
data/*.pdf

# Explicitly ensure curated runtime knowledge bundles are NOT excluded
!data/okf
!data/okf/**
!data/knowledge
!data/knowledge/**

