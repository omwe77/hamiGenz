# ==============================================================================
# hamiGenZ Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Environment (development | production)
# In production, HAMIGENZ_SESSION_SECRET is strictly required (must be 32+ cryptographically random bytes).
HAMIGENZ_ENV=development
HAMIGENZ_SESSION_SECRET=

# LLM Provider Configuration (ollama | gemini)
LLM_PROVIDER=ollama

# Ollama LLM Service (default local provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Google Gemini LLM Service (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Embedding & Retrieval Model (multilingual Nepali/English)
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
REINDEX_ON_STARTUP=1

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:3000
CORS_EXTRA_ORIGINS=

# Proxy & Network Configuration
# On Railway, the public HTTP edge router terminates TLS and sets X-Real-IP automatically.
# Railway environment is auto-detected via RAILWAY_ENVIRONMENT or RAILWAY_PROJECT_ID.
# Set TRUST_RAILWAY_PROXY=1 (or true/yes/on) to manually force trust, or 0 (false/no/off) to disable.
# Defaults to unset/0 (automatic detection enabled).
# TRUST_RAILWAY_PROXY=0

# For custom upstream reverse proxies (e.g. Nginx, Cloudflare), configure trusted proxy IPs/CIDRs.
# Only requests originating directly from these trusted peers will have forwarding headers (X-Real-IP,
# CF-Connecting-IP, X-Forwarded-For) evaluated:
TRUSTED_PROXIES=127.0.0.1,::1

# Hugging Face Model Cache (configured to /app/backend/data/huggingface on Railway volume)
# HF_HOME=/app/backend/data/huggingface

# Note: Document storage, vector indexes, and SQLite databases are managed
# automatically under backend/data/ (uploads/, vectors/, and hamigenz.db).
# On Railway, mount a persistent volume at /app/backend/data with exactly 1 replica.
