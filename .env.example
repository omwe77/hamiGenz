# ==============================================================================
# hamiGenZ Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Ollama LLM Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Embedding & Retrieval Model
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
REINDEX_ON_STARTUP=1

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:3000
CORS_EXTRA_ORIGINS=

# Document Storage & Limits
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=backend/data/uploads
VECTOR_DIR=backend/data/vectors
SQLITE_DB_PATH=backend/data/hamigenz.db