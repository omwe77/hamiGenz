# ==============================================================================
# hamiGenZ Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Ollama LLM Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Embedding & Retrieval Model
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
REINDEX_ON_STARTUP=1

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:3000
CORS_EXTRA_ORIGINS=

# Note: Document storage, vector indexes, and SQLite databases are managed
# automatically under backend/data/ (uploads/, vectors/, and hamigenz.db).